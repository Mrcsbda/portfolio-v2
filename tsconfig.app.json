{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "esnext",
    "types": [
      "vite/client"
    ],
    "skipLibCheck": true,
    /* Path aliases */
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@app/*": [
        "./src/app/*"
      ],
      "@modules/*": [
        "./src/modules/*"
      ],
      "@hero/*": [
        "./src/modules/hero/*"
      ],
      "@journey/*": [
        "./src/modules/journey/*"
      ],
      "@stack/*": [
        "./src/modules/stack/*"
      ],
      "@contact/*": [
        "./src/modules/contact/*"
      ],
      "@projects/*": [
        "./src/modules/projects/*"
      ],
      "@assets/*": [
        "./src/assets/*"
      ],
      "@translation/*": [
        "./src/translation/*"
      ]
    },
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src"
  ]
}